<script>
document.addEventListener("DOMContentLoaded", function() {
  var container = document.getElementById("RecentlyViewed-template--21879496245366__recently_viewed_WAcfa9");
  var wrapper = document.getElementById("recently-viewed-wrapper");
  var currentHandle = "beyond-vibe-coding-9798341634756";
  var storageKey = "recentlyViewed";

  var viewed = JSON.parse(localStorage.getItem(storageKey)) || [];

  viewed = viewed.filter(h => h !== currentHandle);
  const fallbackImage = "//ingramacademic.com/cdn/shop/files/ChatGPT_Image_Nov_25_2025_03_07_50_PM.jpg?v=1764713317&width=533";
  viewed.unshift(currentHandle);

  if (viewed.length > 12) viewed = viewed.slice(0, 12);

  localStorage.setItem(storageKey, JSON.stringify(viewed));

  var displayList = viewed.filter(h => h !== currentHandle);

  if (displayList.length > 0) {
    wrapper.hidden = false;

    displayList.forEach(function(handle) {
      
      fetch("/products/" + handle + ".js")
        .then(res => res.json())
        .then(product => {
          var item = document.createElement("li");
          item.classList.add("grid__item");

          const imgSrc = product.images[0] && product.images[0] !== "" && !product.images[0].includes("no-image") 
            ? product.images[0] 
            : fallbackImage;

          item.innerHTML = `
            <div class="card-wrapper">
              <a href="/products/${product.handle}" class="full-unstyled-link">
                <div class="card card--standard">
                  <div class="card__inner">
                    <div class="card__media_recent">
                        <img 
                            src="${imgSrc}" 
                            alt="${product.title}" 
                            loading="lazy" 
                            class="motion-reduce"
                            srcset="
                            ${imgSrc} 165w,
                            ${imgSrc} 360w,
                            ${imgSrc} 533w,
                            ${imgSrc} 720w,
                            ${imgSrc} 940w,
                            ${imgSrc} 1066w
                            "
                            sizes="(min-width: 1200px) 25vw, 
                                (min-width: 992px) 33vw, 
                                (min-width: 768px) 50vw, 
                                100vw"
                        />
                    </div>
                  </div>
                  <div class="card__content">
                    <h3 class="card__heading">${product.title}</h3>
                    <div class="card-information">
                      <span class="price">$${(product.price / 100).toFixed(2)}</span>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          `;
          container.appendChild(item);
        })
        .catch(err => {
          // Fail silently for missing product
          console.warn('Recently viewed product fetch failed for', handle, err);
        });
    });

    // Get buttons after we appended items (but items are appended asynchronously)
    const prevBtn = wrapper.querySelector(".slider-button--prev");
    const nextBtn = wrapper.querySelector(".slider-button--next");

    if (container && prevBtn && nextBtn) {
      const getScrollAmount = () => container.offsetWidth / 4;

      prevBtn.addEventListener("click", () => {
        container.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
        // check after animation
        requestAnimationFrame(() => debounceUpdate());
      });

      nextBtn.addEventListener("click", () => {
        container.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
        requestAnimationFrame(() => debounceUpdate());
      });

      // Debounce helper
      let scrollTimer = null;
      function debounceUpdate() {
        if (scrollTimer) clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          updateArrows();
        }, 120);
      }

      container.addEventListener("scroll", debounceUpdate);
      window.addEventListener("resize", debounceUpdate);

      // Update arrows based on *visibility* of first and last item inside the container viewport
      function updateArrows() {
        const items = container.querySelectorAll(".grid__item");
        if (!items || items.length === 0) {
          // If no items yet, disable both
          prevBtn.disabled = true;
          prevBtn.classList.add("disabled");
          nextBtn.disabled = true;
          nextBtn.classList.add("disabled");
          return;
        }

        const first = items[0];
        const last = items[items.length - 1];

        // container viewport rect
        const containerRect = container.getBoundingClientRect();
        const firstRect = first.getBoundingClientRect();
        const lastRect = last.getBoundingClientRect();

        // Consider an item "fully visible" if its bounding box is wholly inside the container viewport.
        // small epsilon to account for subpixel differences
        const epsilon = 1;

        const firstFullyVisible = (firstRect.left >= containerRect.left - epsilon) && (firstRect.right <= containerRect.right + epsilon);
        const lastFullyVisible  = (lastRect.left >= containerRect.left - epsilon) && (lastRect.right <= containerRect.right + epsilon);

        // If you prefer "partially visible" use the following instead:
        // const firstPartiallyVisible = (firstRect.right > containerRect.left + epsilon) && (firstRect.left < containerRect.right - epsilon);
        // const lastPartiallyVisible  = (lastRect.right > containerRect.left + epsilon) && (lastRect.left < containerRect.right - epsilon);

        // Disable prev when first is fully visible (i.e., scrolled to the start)
        if (firstFullyVisible) {
          prevBtn.disabled = true;
          prevBtn.classList.add("disabled");
        } else {
          prevBtn.disabled = false;
          prevBtn.classList.remove("disabled");
        }

        // Disable next when last is fully visible (i.e., scrolled to the end)
        if (lastFullyVisible) {
          nextBtn.disabled = true;
          nextBtn.classList.add("disabled");
        } else {
          nextBtn.disabled = false;
          nextBtn.classList.remove("disabled");
        }
      }

      // Run initial update after items load. Items are appended asynchronously, so watch for DOM changes.
      const mo = new MutationObserver((mutations) => {
        // if childList changed, run updateArrows shortly after to allow images/layout to settle
        for (const m of mutations) {
          if (m.type === "childList" && m.addedNodes.length) {
            // Wait a little for layout to update (images may affect widths)
            setTimeout(updateArrows, 150);
            return;
          }
        }
      });

      mo.observe(container, { childList: true, subtree: false });

      // If items are already present (rare), update right away
      setTimeout(updateArrows, 400);

      // clean up if needed (optional)
      // window.addEventListener('beforeunload', () => mo.disconnect());
    }
  }
});
</script>


