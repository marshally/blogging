<script>
 document.addEventListener("DOMContentLoaded", function () {
  if (!window.location.href.includes("tools/customr/edit-account")) return;
  
  setTimeout(() => {
    const phoneInput = document.querySelector('input[name="phone"]');
    if (!phoneInput) return;

    let formatTimeout;

   
    function getDigits(value) {
      let digits = value.replace(/\D/g, "");

      if (value.trim().startsWith("+1")) {
        digits = digits.substring(1);
      } else if (digits.length === 11 && digits.startsWith("1")) {
        digits = digits.substring(1);
      }

      return digits.substring(0, 10);
    }

    function formatPhone(value) {
      const digits = getDigits(value);

      if (!digits) return "";
      if (digits.length < 4) return `(${digits}`;
      if (digits.length < 7) {
        return `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
      }

      return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
    }

    function applyFormatting() {
      phoneInput.value = formatPhone(phoneInput.value);
    }

    applyFormatting();

    phoneInput.addEventListener("focus", function () {
      setTimeout(() => {
        applyFormatting();
      }, 1);
    });
    function updatePhoneFieldValidation(e) {
    const parentField = phoneInput.closest(".cf-field");    
    if (!parentField) return;    
    setTimeout(() => {
      if (parentField && parentField.classList.contains("submitaction")) {
        parentField.querySelector(".cf-field-errors-new")?.remove();         
        
      } else { 
        
        if (phoneInput.value.trim() === "") { 
           parentField.querySelector(".cf-field-errors-new")?.remove();       
          parentField.setAttribute("data-cf-invalid", "false");
          
        } else if ( phoneInput.value.trim().length >= 1){ 
          const phoneValue = phoneInput.value.trim().replace(/\s/g, "");
          let numericValue = phoneValue.replace(/^\+\d{1,3}\s*/, "").replace(/\D/g, "");

          // Remove first digit if country code exists
          
          if ( numericValue.length <= 9){       
            parentField.querySelector(".cf-field-errors-new")?.remove();       
            parentField.setAttribute("data-cf-invalid", "true");
            var errormessage = `<ul class="cf-field-errors cf-field-errors-new"><li class="validphone-error"><span role="alert" aria-live="assertive" aria-atomic="true" aria-relevant="additions">Please provide a valid phone number</span></li></ul>`;
            parentField.insertAdjacentHTML("beforeend", errormessage);
          }
          var errortext = parentField.querySelector(".cf-field-errors");
          
           
           
           
          if ( numericValue.length >= 10){
            parentField.setAttribute("data-cf-invalid", "false");
            if(parentField.querySelector(".cf-field-errors-new")) {
              parentField.querySelector(".cf-field-errors-new .validphone-error").style.display = "none";
            }
          }else if(numericValue.length < 10){
            parentField.setAttribute("data-cf-invalid", "true");
            if(parentField.querySelector(".cf-field-errors-new")) {
              parentField.querySelector(".cf-field-errors-new .validphone-error").style.display = "block";
            }
          }       
          if (errortext?.textContent.includes("Please provide a valid phone number") || errortext?.textContent.includes("Please provide a valid phone number") && errortext?.textContent.includes("Must not be blank")){
          } else{
            parentField.setAttribute("data-cf-invalid", "false");
          }       
        }
      }
    }, 100);
  }
    phoneInput.addEventListener("blur", updatePhoneFieldValidation);
    phoneInput.addEventListener("keydown", function (e) {
      const digits = getDigits(phoneInput.value);

      const allowedKeys = [
        "Backspace",
        "Delete",
        "ArrowLeft",
        "ArrowRight",
        "Tab"
      ];

      if (
        digits.length >= 10 &&
        !allowedKeys.includes(e.key) &&
        /\d/.test(e.key)
      ) {
        e.preventDefault();
      }
    });

    phoneInput.addEventListener("input", function () {
      clearTimeout(formatTimeout);

      formatTimeout = setTimeout(() => {
        applyFormatting();
      }, 1);
    });

  }, 1000);
});
 
  
</script>