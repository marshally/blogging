          <script>
            function stockcheckapi() {
              // Function to show the error modal
              function showErrorModal() {
                const modal = document.getElementById('errorModal');
                modal.style.display = 'flex';

                document.getElementById('reloadButton').addEventListener('click', function () {
                  location.reload();
                  modal.style.display = 'none';
                });

                document.getElementById('cancelButton').addEventListener('click', function () {
                  modal.style.display = 'none';
                });
              }

              // Function to fetch stock information for a single variant
              function fetchStockInfo(variantSKU, pubdate, requiresshipping) {
                if(requiresshipping === true ){ 
                  var apiUrl = 'https://mediascout-uat.ingramcontent.com/api/devCheckProductStock';
                  return fetch(apiUrl + '?isbn=' + variantSKU + '&publicationDate=' + pubdate,  {
                    method: 'GET',
                    headers: {
                      'Content-Type': 'application/json',
                    },
                  })
                  .then((response) => response.json())
                  .then((data) => {
                    return data; // Return the stock information
                  });
                }else if(requiresshipping === false){
                  var ebookisbn = variantSKU;
                  var apiVitalUrl = 'http://mediascout-uat.ingramcontent.com/api/qaCheckDigitalStock';
                  return fetch(apiVitalUrl, {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                      isbn: ebookisbn
                    })
                  })
                  .then((response) => response.json())
                  .then((data) => {
                    const arrayData = Array.isArray(data) ? data : [data];
                    //console.log('Stock API Response for SKU ' + variantSKU + ':', data);
                    return arrayData; // Return the stock information
                  })
                }
              }

              // Function to get the updated cart state (after any changes like removing products)
              function getUpdatedCart() {
                return fetch('/cart.js') // Shopify's API endpoint for the current cart state
                  .then((response) => response.json())
                  .then((cart) => {
                    // Filter items to only include those that require shipping (physical products)
                    // console.log("cart.items", cart.items);
                    return cart.items
                      
                      .map((item, index) => {
                        var requiresshipping = item.requires_shipping;
                        const cartpubdate = document.querySelectorAll('#publicationDate');
                        //console.log("cartpubdate[0].attributes[1].value", cartpubdate[index].attributes[1].value)
                        const pubdate = cartpubdate[index].attributes[1].value;
                        return {
                          sku: item.sku,
                          title: item.product_title,
                          pubdate: pubdate,
                          requiresshipping: requiresshipping
                        };
                      });
                  });
              }

              // Function to clear all previous error messages before re-checking stock
              function clearAllErrorMessages() {
                const errorItems = document.querySelectorAll('.cart-item__error-text');
                errorItems.forEach(function (error) {
                  error.textContent = ''; // Clear the error text
                });
                const errorContainers = document.querySelectorAll('.CartDrawer-LineItemError');
                errorContainers.forEach(function (container) {
                  container.classList.remove('show'); // Hide the error containers
                });
              }

              // Function to check stock for all product variants in the cart
              function checkProductStockAndProceedToCheckout(checkoutButton) {
                clearAllErrorMessages(); // Clear previous error messages before rechecking stock
                // Get updated cart items dynamically after removal
                getUpdatedCart()
                  .then((productVariants) => {
                    // If no items in the cart, enable checkout button
                    if (productVariants.length === 0) {
                      checkoutButton.disabled = false; // Re-enable button if cart is empty
                    }

                    // Fetch stock information for each physical product variant
                    let fetchStockPromises = productVariants.map((variant) => fetchStockInfo(variant.sku, variant.pubdate, variant.requiresshipping));

                    // Array to store fetched stock information
                    let outOfStockProducts = [];
                    let instockProducts =[];
                    let daysUntilPublicationRaw;
                    let daysUntilPublication;
                    let allProductsInStock = true;
                    let publicationDate;
                    let todayFormatted;
                    let preorderDays;
                    let today ;
                    let yyyy;
                    let mm; 
                    let dd; 
                    let pubDateObj; 
                    let todayObj;
                    // Resolve all promises and handle results
                    Promise.all(fetchStockPromises)
                      .then((results) => {
                        // Loop through the stock results and check for out-of-stock products
                        results.forEach(function (data, index) {
                         // console.log("datallllllll", data);                           
                            publicationDate = data[0].publicationDate;
                           // console.log("data above publicationDate", publicationDate);
                            preorderDays = "120";
                                        // Get today's date in YYYY-MM-DD format
                            today = new Date();
                            yyyy = today.getFullYear();
                            mm = String(today.getMonth() + 1).padStart(2, '0'); // Months are 0-based
                            dd = String(today.getDate()).padStart(2, '0');
                            todayFormatted = `${yyyy}-${mm}-${dd}`;
                          //  console.log("Today's date (YYYY-MM-DD):", todayFormatted);


                          //  console.log("Publication Date:", publicationDate);
                            pubDateObj = new Date(publicationDate);
                            todayObj = new Date(todayFormatted);

                            // Check for invalid date
                            if (isNaN(pubDateObj?.getTime())) {
                             // console.error("Invalid publication date format:", publicationDate);
                            }

                            const diffInMs = pubDateObj.getTime() - todayObj.getTime();
                            daysUntilPublicationRaw = Math.ceil(diffInMs / (1000 * 60 * 60 * 24));
                            daysUntilPublication = Math.max(0, daysUntilPublicationRaw); // Prevent negative days

                          //  console.log("Days until publication:", daysUntilPublicationRaw, daysUntilPublication);

                           // console.log("PreorderDays:", preorderDays);
                            if(data[0].inStock){
                              if(daysUntilPublicationRaw > preorderDays){
                                instockProducts.push(productVariants[index].title);
                               // console.log("instockProducts", instockProducts);
                              }
                            }else if(data[0].distributable === true){
                             // if(daysUntilPublicationRaw > preorderDays){
                                instockProducts.push(productVariants[index].title);
                                //console.log("instockProducts", instockProducts);
                              //}
                            }else if ( data[0].distributable == false){
                              allProductsInStock = false; // Mark that not all products are in stock
                              outOfStockProducts.push(productVariants[index].title); 
                            }else if (!data[0].inStock) {
                                allProductsInStock = false; // Mark that not all products are in stock
                                outOfStockProducts.push(productVariants[index].title); // Add to out-of-stock list
                              }
                            
                        });
                        // If any products are out of stock, prevent checkout
                        if (allProductsInStock) {
                          // If all products are in stock, proceed to checkout
                         // window.location.href = '/checkout'; // Redirect to checkout URL
                          if ( daysUntilPublicationRaw > preorderDays){
                           // console.log("cart item is in stcok but preorder days are over 120 days");
                            document.getElementById("CartDrawer-Checkout").setAttribute("disabled", "true");
                            checkOutOfStockProductsInCart(instockProducts);
                            return false; // Prevent checkout
                          } else {
                             window.location.href = '/checkout'; // Redirect to checkout URL
                            // console.log(" Redirect to checkout URL");
                          }
                        } else {
                           if(publicationDate > todayFormatted && !allProductsInStock ){
                               // console.log("out of stock and in PREORDER state");
                              window.location.href = '/checkout'; // Redirect to checkout URL
                           }
                           else if (daysUntilPublication > preorderDays && !allProductsInStock){
                           // console.log("out of stock and not in preorder state...");
                             checkoutButton.disabled = true;
                          checkOutOfStockProductsInCart(outOfStockProducts);
                          return false; // Prevent checkout
                          } else {
                           //console.log("in else part");
                             checkoutButton.disabled = true;
                          checkOutOfStockProductsInCart(outOfStockProducts);
                          return false; // Prevent checkout
                          }
                        }
                      })
                      .catch((error) => {
                        console.error('Error checking stock:', error);
                        showErrorModal();
                        checkoutButton.disabled = false; //here Re-enable the button in case of error
                        return false;
                      });
                  })
                  .catch((error) => {
                    console.error('Error fetching cart state:', error);
                    checkoutButton.disabled = false; // here Re-enable the button if cart fetch fails
                  });
              }

              function checkOutOfStockProductsInCart(outOfStockProducts) {
                // Fetch the cart data
                fetch('/cart.js')
                  .then((response) => response.json())
                  .then((cart) => {
                  //  console.log('here please outOfStockProducts', outOfStockProducts);
                  //  console.log('cart.items', cart.items);

                    // Loop through outOfStockProducts and check if each one exists in the cart
                    outOfStockProducts.forEach((productTitle) => {
                      const productInCart = cart.items.find((item) => item.product_title === productTitle);
                      const productInCartIndex =
                        cart.items.findIndex((item) => item.product_title === productTitle) + 1;
                      // If the product exists in the cart, log its SKU
                      if (productInCart) {
                        var outofStockLineItem = document.getElementById(
                          'CartDrawer-LineItemError-' + productInCartIndex
                        );
                       // console.log('outofStockLineItem basket', outofStockLineItem);
                        // if (outofStockLineItem) {
                        var errorText = outofStockLineItem.querySelector('.cart-item__error-text');
                        errorText.textContent = 'This product is not available please remove'; // Set the error message
                        outofStockLineItem.classList.add('show'); // Show error message
                        // console.log(`Product SKU for "${productTitle}": ${productInCart.variant.sku}`);
                      } else {
                        console.log('all product are in stock');
                      }
                    });
                  })
                  .catch((error) => {
                    console.error('Error fetching cart data:', error);
                  });
              }

              // Disable the checkout button initially while we check stock
              var checkoutButton = document.getElementById('CartDrawer-Checkout');
           // console.log("checkoutButton", checkoutButton);
              // Listen for the checkout button click
              var remember = document.querySelector('.CartAgree');
              if (remember.checked) {
                checkProductStockAndProceedToCheckout(checkoutButton);
              } else {
                alert('You must agree with the terms and conditions of sales to check out');
              }
            }
          </script>
