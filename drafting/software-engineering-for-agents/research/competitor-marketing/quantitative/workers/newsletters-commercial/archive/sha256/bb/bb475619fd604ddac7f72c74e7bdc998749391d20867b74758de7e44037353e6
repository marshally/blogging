ong direction."}]},{"type":"paragraph","content":[{"type":"text","text":"What feedback loops would you use to preserve both comprehensibility and architectural integrity as agentic coding scales?"}]},{"type":"paragraph","content":[{"type":"text","text":"Diego Pacheco"}]}]},"publication_id":2115638,"post_id":210128469,"user_id":20581408,"ancestor_path":"","type":"comment","deleted":false,"date":"2026-08-09T05:20:01.506Z","edited_at":null,"status":"published","pinned_by_user_id":null,"restacks":0,"name":"Diego Pacheco","photo_url":"https://substack-post-media.s3.amazonaws.com/public/images/f204c156-bbac-47d5-81cc-257633b80eb8_216x222.png","handle":"diegopacheco546760","reactor_names":[],"reaction":null,"reactions":{"❤":5},"reaction_count":5,"children":[],"bans":[],"suppressed":false,"user_banned":false,"user_banned_for_comment":false,"user_slug":"diegopacheco546760","metadata":{"is_author":false,"membership_state":null,"eligibleForGift":true,"author_on_other_pub":{"name":"Diego Pacheco Tech Substack","id":2764157,"base_url":"https://diegopachecotech.substack.com"}},"user_bestseller_tier":null,"can_dm":true,"userStatus":{"bestsellerTier":null,"subscriberTier":1,"leaderboard":null,"vip":false,"badge":{"type":"subscriber","tier":1,"accent_colors":null},"subscriber":null},"score":6,"children_count":0,"reported_by_user":false,"restacked":false},{"id":310643482,"body":"Having some specific on how to implement the feedback loop for agent generated code will be great","body_json":{"type":"doc","attrs":{"schemaVersion":"v1","title":null},"content":[{"type":"paragraph","content":[{"type":"text","text":"Having some specific on how to implement the feedback loop for agent generated code will be great"}]}]},"publication_id":2115638,"post_id":210128469,"user_id":7339320,"ancestor_path":"","type":"comment","deleted":false,"date":"2026-08-08T14:41:49.584Z","edited_at":null,"status":"published","pinned_by_user_id":null,"restacks":0,"name":"Israel Ferrer","photo_url":"https://substack-