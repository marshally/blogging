  <!--
  Conversion / outbound-click tracking for GA4 (Measurement ID G-QLSQW43X99).
  Purchases happen off-site (Amazon/O'Reilly/Leanpub etc.), so the trackable
  proxy is the outbound click. We fire two custom GA4 events that you can mark
  as Key events (conversions) in GA4 Admin > Key events:
    - book_click        (intent to buy a book; outbound to a retailer / book link)
    - newsletter_click  (intent to subscribe; outbound/click to Substack)
  This piggybacks on the GA4 Google tag already loaded on the page, so it does
  NOT add a second page_view. If gtag is somehow missing it lazy-loads it with
  send_page_view:false as a safety net.
-->
<script>
(function () {
  var GA4_ID = 'G-QLSQW43X99';

  function ensureGtag() {
    if (typeof window.gtag === 'function') return; // tag already on the page
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
    document.head.appendChild(s);
    window.gtag('js', new Date());
    window.gtag('config', GA4_ID, { send_page_view: false });
  }

  function track(name, params) {
    try { ensureGtag(); window.gtag('event', name, params || {}); } catch (e) {}
  }

  function retailerForHost(host) {
    host = (host || '').toLowerCase();
    if (/(^|\.)(amazon\.|amzn\.)/.test(host)) return 'amazon';
    if (/oreilly\.com$/.test(host) || /(^|\.)oreilly\.com/.test(host)) return 'oreilly';
    if (/leanpub\.com/.test(host)) return 'leanpub';
    if (/smashingmagazine\.com/.test(host)) return 'smashing';
    if (/books\.apple\.com/.test(host)) return 'apple_books';
    if (/play\.google\.com/.test(host)) return 'google_play';
    if (/gumroad\.com/.test(host)) return 'gumroad';
    return null;
  }

  function text(el) {
    return (el && (el.textContent || '')).replace(/\s+/g, ' ').trim().slice(0, 100);
  }

  document.addEventListener('click', function (e) {
    var t = e.target;
    if (!t || !t.closest) return;
    var a = t.closest('a[href]');
    if (!a) return;

    var href = a.getAttribute('href') || '';
    if (!/^https?:/i.test(href)) return; // ignore in-page anchors, mailto, javascript:

    var url;
    try { url = new URL(href, window.location.href); } catch (_) { return; }
    var host = url.hostname;
    var location = window.location.pathname;

    // 1) Explicit CTA elements (data attributes win)
    var bookEl = t.closest('[data-book]');
    var newsEl = t.closest('[data-newsletter]');

    // 2) Homepage / featured book grid
    var inBookGrid = !!t.closest('.books-container');

    var isBook = !!bookEl || inBookGrid || !!retailerForHost(host);
    var isNewsletter = !!newsEl || /(^|\.)substack\.com$/.test(host) || /substack\.com/.test(host);

    if (isBook) {
      var figure = t.closest('figure.thumb');
      var bookName =
        (bookEl && bookEl.getAttribute('data-book')) ||
        (figure && text(figure.querySelector('h2'))) ||
        text(a) ||
        'unknown';
      var retailer =
        (bookEl && bookEl.getAttribute('data-retailer')) ||
        retailerForHost(host) ||
        'redirect';
      track('book_click', {
        book: bookName,
        retailer: retailer,
        location: location,
        link_domain: host,
        link_url: url.href.slice(0, 300)
      });
      return;
    }

    if (isNewsletter) {
      track('newsletter_click', {
        location: location,
        source: (newsEl && newsEl.getAttribute('data-newsletter')) || 'link',
        link_domain: host,
        link_url: url.href.slice(0, 300)
      });
      return;
    }
  }, true); // capture phase so it runs even if other handlers stopPropagation
})();
</script>


